# ---- Copia questo file in .env e compila i valori ----

# Sottodominio che punta (record DNS A/AAAA) all'IP del server Ubuntu
DOMAIN=neurospec.peukeia.eu
# Email usata da Let's Encrypt per gli avvisi di scadenza certificato
ACME_EMAIL=fedeleluisi@gmail.com
# URL pubblico dell'app (serve per i link assoluti delle foto)
PUBLIC_URL=https://neurospec.peukeia.eu

# Token segreto degli organizzatori: chi lo conosce può inviare notifiche push
# e cancellare qualsiasi record. Generane uno lungo, es.:  openssl rand -hex 24
ADMIN_TOKEN=cambia-questo-valore

# Token del cassiere delle quote uniche (Dott. Paolo Roberto): con questo, nella PWA
# (⚙️ Impostazioni) vede le quote versate a lui, le segna come ricevute e scarica il CSV
# per Excel. Non dà i poteri dell'organizzatore. Generalo con:  openssl rand -hex 24
TREASURER_TOKEN=
# Facoltativo, un token per singolo cassiere (id in maiuscolo dal blocco giftCollectors del JSON):
# chi lo usa vede, segna come ricevute e scarica solo le quote versate a lui.
TREASURER_TOKEN_ROBERTO=
TREASURER_TOKEN_AKI=
# Token personale di ogni festeggiato (header X-Graduate-Token, da inserire nella PWA in ⚙️ Impostazioni):
# apre l'area 🎓 Festeggiato (chi viene, auguri ricevuti, le proprie coordinate, il proprio avatar
# dell'assistente). <ID> = id del neo-specialista in giftTargets (es. LUISI). openssl rand -hex 24
GRADUATE_TOKEN_LUISI=
# Email privata di ogni festeggiato (facoltativa): riceve un'email a ogni augurio per lui e può
# farsi mandare il link della sua area (⚙️ → "Sono un festeggiato"), senza bisogno del token.
# Va qui e non in seed/event-data.json, che è pubblico. <ID> come sopra (es. TOTARO).
GRADUATE_EMAIL_TOTARO=

# Contatto associato alle chiavi Web Push (formato mailto:)
VAPID_SUBJECT=mailto:fedeleluisi@gmail.com

# true = popola il DB con invitati/auguri/foto DI ESEMPIO al primo avvio (solo per provare)
SEED_DEMO_DATA=false

# true = al riavvio aggiorna anche testi e IBAN/link dei regali già presenti nel database
# leggendoli da seed/event-data.json. false = aggiunge solo i regali nuovi (e toglie quelli
# rimossi dal JSON). Rimetti false dopo l'aggiornamento se preferisci.
GIFT_SYNC_UPDATE_TEXTS=false

# Ogni quanti secondi pubblicare le notifiche programmate arrivate a scadenza
SCHEDULER_INTERVAL_S=20

# Cartella con i file della PWA (clone del repo spec2026app, sottocartella pwa)
PWA_DIR=../spec2026app/pwa

# Origini autorizzate (CORS). "*" va bene se la PWA è servita dallo stesso dominio.
CORS_ORIGINS=*
# Dimensione massima delle foto caricate (MB)
MAX_UPLOAD_MB=10

# ---- Assistente vocale con avatar (Mistral) ----
# Chiave API Mistral (https://console.mistral.ai): trascrizione con Voxtral, conversazione con
# function calling e sintesi vocale con voci clonate. Vuota = assistente disattivato.
MISTRAL_API_KEY=
# Modelli (di norma non servono modifiche)
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
# Voce preimpostata di Mistral per gli avatar senza campione ("voce di fantasia").
# Vuota = la prima voce preimpostata restituita dall'API (elenco in PWA -> Impostazioni -> Assistente).
ASSISTANT_FALLBACK_VOICE_ID=
# true = simulatore locale al posto di Mistral (nessun costo, risposte finte): solo per provare la PWA
ASSISTANT_FAKE=false

# ---- Automazioni con n8n (opzionale, vedi README "Automazioni con n8n") ----
# URL del nodo Webhook di n8n che riceve gli eventi (nuovo RSVP, navetta, auguri, foto, regali,
# notifiche). Vuoto = nessun webhook. Se n8n è un container sulla stessa rete Docker (proxy_network)
# si può usare l'indirizzo interno, es. http://n8n:5678/webhook/neuroparty; altrimenti quello
# pubblico dietro Caddy, es. https://n8n.tuodominio.it/webhook/neuroparty
N8N_WEBHOOK_URL=
# Segreto condiviso: viene inviato nell'header X-Automation-Secret (in n8n: Webhook -> Header Auth)
# e usato per firmare il corpo (X-NeuroParty-Signature). Generalo con: openssl rand -hex 24
N8N_WEBHOOK_SECRET=
# Quali eventi inviare: * = tutti, oppure lista con jolly, es. guest.*,bus.booked,gift.pooled
N8N_WEBHOOK_EVENTS=*
# Token di SOLA LETTURA per n8n (header X-Automation-Token): report, riepiloghi, export CSV.
# Così n8n non ha bisogno dell'ADMIN_TOKEN. Generalo con: openssl rand -hex 24
AUTOMATION_TOKEN=
