# ---- Copia questo file in .env e compila i valori ----

# Sottodominio che punta (record DNS A/AAAA) all'IP del server Ubuntu
DOMAIN=neurospec.peukeia.eu
# Email usata da Let's Encrypt per gli avvisi di scadenza certificato
ACME_EMAIL=fedeleluisi@gmail.com
# URL pubblico dell'app (serve per i link assoluti delle foto)
PUBLIC_URL=https://neurospec.peukeia.eu

# Token segreto degli organizzatori: chi lo conosce può inviare notifiche push
# e cancellare qualsiasi record. Generane uno lungo, es.:  openssl rand -hex 24
ADMIN_TOKEN=cambia-questo-valore

# Contatto associato alle chiavi Web Push (formato mailto:)
VAPID_SUBJECT=mailto:fedeleluisi@gmail.com

# true = popola il DB con invitati/auguri/foto DI ESEMPIO al primo avvio (solo per provare)
SEED_DEMO_DATA=false

# true = al riavvio aggiorna anche testi, IBAN/link e obiettivo dei regali già presenti nel
# database leggendoli da seed/event-data.json (le quote raccolte restano intatte).
# false = aggiunge solo i regali nuovi. Rimetti false dopo l'aggiornamento se preferisci.
GIFT_SYNC_UPDATE_TEXTS=false

# Ogni quanti secondi pubblicare le notifiche programmate arrivate a scadenza
SCHEDULER_INTERVAL_S=20

# Cartella con i file della PWA (clone del repo spec2026app, sottocartella pwa)
PWA_DIR=../spec2026app/pwa

# Origini autorizzate (CORS). "*" va bene se la PWA è servita dallo stesso dominio.
CORS_ORIGINS=*
# Dimensione massima delle foto caricate (MB)
MAX_UPLOAD_MB=10
